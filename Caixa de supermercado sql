-- create
CREATE TABLE produto (
id_produto INT AUTO_INCREMENT PRIMARY KEY,
codigo_barras VARCHAR (100) NOT NULL,
nome VARCHAR (100) NOT NULL,
preco_venda decimal
);
CREATE TABLE operador (
id_operador int auto_increment primary key,
nome varchar (100) not null,
matricula varchar (100) not null
);
create table caixa_terminal (
id_terminal int auto_increment primary key,
status_terminal VARCHAR (100)
);
create table venda (
id_venda int auto_increment primary key,
data_hora datetime not null,
id_terminal int not null,
id_operador int not null,
valor_total decimal (10, 2) not null,
foreign key (id_terminal) references caixa_terminal (id_terminal),
foreign key (id_operador) references operador (id_operador)
);
create table venda_item (
id_venda_item int auto_increment primary key,
id_venda int not null,
id_produto int not null,
quantidade decimal (10, 3) not null,
preco_unitario_pago decimal (10, 2) not null,
subtotal decimal (10, 2) generated always as (quantidade * preco_unitario_pago) stored,
foreign key (id_venda) references venda (id_venda),
foreign key (id_produto) references produto (id_produto)
);
create table forma_pagamento (
id_forma_pagto int auto_increment primary key not null,
descricao varchar (100)

);
create table venda_pagamento (
id_venda_pagto int auto_increment primary key not null,
id_venda int not null,
id_forma_pagto int not null,
valor_pago decimal (10, 2) not null
);
