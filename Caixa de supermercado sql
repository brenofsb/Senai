-- relatórios
-- cadastros
SELECT
p.id_produto,
p.codigo_barras,
p.nome,
p.preco_venda
FROM produto p
ORDER BY p.nome;
SELECT
o.id_operador,
o.matricula,
o.nome
FROM operador o
ORDER BY o.nome;
SELECT
t.id_terminal,
t.status_terminal
FROM caixa_terminal t
ORDER BY t.id_terminal;
SELECT
f.id_forma_pagto,
f.descricao
FROM forma_pagamento f
ORDER BY f.id_forma_pagto;
-- vendas
SELECT
v.id_venda,
DATE_FORMAT(v.data_hora, '%d/%m/%Y %H:%i') AS data_hora,
t.id_terminal,
o.nome AS operador,
v.valor_total
FROM venda v
JOIN caixa_terminal t ON t.id_terminal = v.id_terminal
JOIN operador o ON o.id_operador = v.id_operador
WHERE DATE(v.data_hora) BETWEEN '2025-06-01' AND '2025-06-06'
ORDER BY v.data_hora;

SELECT
v.id_venda,
DATE_FORMAT(v.data_hora, '%d/%m/%Y %H:%i') AS data_hora,
p.codigo_barras,
p.nome AS produto,
vi.quantidade,
vi.preco_unitario_pago,
vi.subtotal
FROM venda_item vi
JOIN venda v ON v.id_venda = vi.id_venda
JOIN produto p ON p.id_produto = vi.id_produto
WHERE DATE(v.data_hora) BETWEEN '2025-06-01' AND '2025-06-06'
ORDER BY v.data_hora, p.nome;
SELECT
fp.descricao AS forma_pagamento,
COUNT(vp.id_venda) AS qtd_vendas,
SUM(vp.valor_pago) AS total_recebido
FROM venda_pagamento vp
JOIN forma_pagamento fp ON fp.id_forma_pagto = vp.id_forma_pagto
JOIN venda v ON v.id_venda = vp.id_venda
WHERE DATE(v.data_hora) BETWEEN '2025-06-01' AND '2025-06-06'
GROUP BY fp.id_forma_pagto, fp.descricao
ORDER BY total_recebido DESC;
SELECT
p.codigo_barras,
p.nome AS produto,
SUM(vi.quantidade) AS qtd_total_vendida,
SUM(vi.subtotal) AS receita_total
FROM venda_item vi
JOIN produto p ON p.id_produto = vi.id_produto
JOIN venda v ON v.id_venda = vi.id_venda
WHERE DATE(v.data_hora) BETWEEN '2025-06-01' AND '2025-06-06'
GROUP BY p.id_produto, p.codigo_barras, p.nome
ORDER BY qtd_total_vendida DESC;
SELECT
o.matricula,
o.nome AS operador,
COUNT(v.id_venda) AS qtd_vendas,
SUM(v.valor_total) AS total_vendido
FROM venda v
JOIN operador o ON o.id_operador = v.id_operador
WHERE DATE(v.data_hora) BETWEEN '2025-06-01' AND '2025-06-06'
GROUP BY o.id_operador, o.matricula, o.nome
ORDER BY total_vendido DESC;

-- resumo geral
SELECT
DATE(v.data_hora) AS data,
COUNT(v.id_venda) AS qtd_vendas,
SUM(v.valor_total) AS total_do_dia
FROM venda v
WHERE DATE(v.data_hora) BETWEEN '2025-06-01' AND '2025-06-06'
GROUP BY DATE(v.data_hora)
ORDER BY data;
